import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  ButtonItem,
  Focusable,
  Navigation,
  NavEntryPositionPreferences,
  PanelSection,
  PanelSectionRow,
  Router,
  TextField,
  ToggleField,
  DropdownItem,
} from "@decky/ui";
import { callable, definePlugin, routerHook } from "@decky/api";

type FileEntry = {
  name: string;
  path: string;
  is_dir: boolean;
  size: number | null;
  modified: number;
};

const listDir = callable<[string], { path: string; items: FileEntry[] }>("list_dir");

function FileManagerPage() {
  const [path, setPath] = useState("/home/deck");
  const [editedPath, setEditedPath] = useState("/home/deck");
  const historyRef = useRef<Array<{ path: string; focusTarget: string | null }>>([]);
  const [items, setItems] = useState<FileEntry[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [focusPath, setFocusPath] = useState<string | null>(null);
  const [showHidden, setShowHidden] = useState(false);
  const [sortOrder, setSortOrder] = useState("asc");
  const [fileTypeFilter, setFileTypeFilter] = useState("all");
  const backTimeout = useRef<number | null>(null);
  const isLongBack = useRef(false);
  const itemRefs = useRef<Record<string, HTMLDivElement | null>>({});

  const loadPath = useCallback(
    async (newPath: string, notFoundMsg?: string, pushHistory = true, focusTarget: string | null = null) => {
      setLoading(true);
      setError(null);
      try {
        const res = await listDir(newPath);
        if (pushHistory && newPath !== path) {
          historyRef.current = [...historyRef.current, { path, focusTarget }];
        }
        setPath(res.path);
        setEditedPath(res.path);
        setItems(res.items);
        setFocusPath(focusTarget);
      } catch (e) {
        setError(notFoundMsg ?? "Não foi possível carregar o diretório.");
      } finally {
        setLoading(false);
      }
    },
    [path],
  );

  const goBack = useCallback(() => {
    setError(null);
    if (historyRef.current.length > 0) {
      const previousEntry = historyRef.current[historyRef.current.length - 1];
      historyRef.current = historyRef.current.slice(0, -1);
      loadPath(previousEntry.path, "Diretório não existe.", false, previousEntry.focusTarget);
    }
  }, [loadPath]);

  const exitPlugin = useCallback(() => {
    Router.CloseSideMenus();
    Navigation.NavigateBack?.();
  }, []);

  const handleCancel = useCallback((evt: CustomEvent) => {
    evt.preventDefault?.();
  }, []);

  useEffect(() => {
    const input = (window as any).SteamClient?.Input;
    let unregister: any;

    if (input?.RegisterForControllerInputMessages) {
      unregister = input.RegisterForControllerInputMessages(
        (_controllerIndex: number, gamepadButton: number, isPressed: boolean) => {
          if (gamepadButton !== 1) return; // GAMEPAD_BUTTON_B
          if (isPressed) {
            isLongBack.current = false;
            if (backTimeout.current) {
              window.clearTimeout(backTimeout.current);
            }
            backTimeout.current = window.setTimeout(() => {
              isLongBack.current = true;
              exitPlugin();
            }, 150);
          } else {
            if (backTimeout.current) {
              window.clearTimeout(backTimeout.current);
              backTimeout.current = null;
            }
            if (!isLongBack.current) {
              goBack();
            }
            isLongBack.current = false;
          }
        },
      );
    }

    return () => {
      if (backTimeout.current) {
        window.clearTimeout(backTimeout.current);
        backTimeout.current = null;
      }
      if (typeof unregister === "function") {
        unregister();
      } else if (unregister?.Unregister) {
        unregister.Unregister();
      }
    };
  }, [exitPlugin, goBack]);

  const initialLoadDone = useRef(false);

  useEffect(() => {
    if (initialLoadDone.current) return;
    initialLoadDone.current = true;
    loadPath(path);
  }, [loadPath, path]);

  const openContextMenu = useCallback(
    (item: FileEntry) => {
      // placeholder for future actions
      console.log("Ações para", item.path);
    },
    [],
  );

  const focusSelectedItem = useCallback(() => {
    if (loading || !items.length) return;

    const targetPath = focusPath ?? items.find((item) => item.is_dir)?.path ?? null;
    if (!targetPath) return;

    const row = itemRefs.current[targetPath];
    const focusable = row?.querySelector<HTMLElement>("button, [role='button'], [tabindex='0']");
    focusable?.focus();
  }, [focusPath, items, loading]);

  useEffect(() => {
    focusSelectedItem();
  }, [focusSelectedItem]);

  const fileRows = useMemo(() => {
    if (loading) return <PanelSectionRow>Carregando...</PanelSectionRow>;
    if (error) return <PanelSectionRow>{error}</PanelSectionRow>;

    let filtered = items;

    // Filter hidden files
    if (!showHidden) {
      filtered = filtered.filter((item) => !item.name.startsWith("."));
    }

    // Filter by type
    if (fileTypeFilter === "folders") {
      filtered = filtered.filter((item) => item.is_dir);
    } else if (fileTypeFilter === "files") {
      filtered = filtered.filter((item) => !item.is_dir);
    }

    // Sort by name
    filtered = filtered.sort((a, b) => {
      const comparison = a.name.localeCompare(b.name);
      return sortOrder === "asc" ? comparison : -comparison;
    });

    if (!filtered.length) return <PanelSectionRow>Pasta vazia.</PanelSectionRow>;

    return (
      <>
        {filtered.map((item) => (
          <div
            key={item.path}
            ref={(el) => {
              itemRefs.current[item.path] = el;
            }}
          >
            <PanelSectionRow>
              <Focusable
                onActivate={() => {
                  if (item.is_dir) {
                    loadPath(item.path, undefined, true, item.path);
                  }
                }}
                onMenuButton={() => openContextMenu(item)}
              >
                <ButtonItem
                  onClick={() => {
                    if (item.is_dir) {
                      loadPath(item.path, undefined, true, item.path);
                    }
                  }}
                  layout="below"
                >
                  <div style={{ width: "100%", display: "flex", justifyContent: "flex-start", textAlign: "left" }}>
                    {item.is_dir ? "📁 " : "📄 "}
                    {item.name}
                  </div>
                </ButtonItem>
              </Focusable>
            </PanelSectionRow>
          </div>
        ))}
      </>
    );
  }, [error, items, loadPath, loading, openContextMenu, showHidden, sortOrder, fileTypeFilter]);

  return (
    <Focusable
      style={{ height: "100%" }}
      onCancel={handleCancel}
      onCancelButton={handleCancel}
    >
      <div style={{ height: "100%", display: "flex", flexDirection: "column", paddingTop: 56, boxSizing: "border-box" }}>
        <div style={{ width: "100%", padding: "10px" }}>
          <TextField
            value={editedPath}
            onChange={(e: React.ChangeEvent<HTMLInputElement>) => setEditedPath(e.currentTarget.value)}
            bShowCopyAction={false}
            tooltip="Caminho atual"
            style={{ width: "100%" }}
          />
        </div>

        <Focusable 
          navEntryPreferPosition={NavEntryPositionPreferences.MAINTAIN_X}
        >
          <div style={{ display: "flex", gap: "12px", width: "100%" }}>
            <PanelSectionRow>
              <ToggleField
                label="Ocultos"
                checked={showHidden}
                onChange={setShowHidden}
              />
            </PanelSectionRow>
            <PanelSectionRow>
              <DropdownItem
                label="Ordem"
                rgOptions={[
                  { label: "A-Z", data: "asc" },
                  { label: "Z-A", data: "desc" },
                ]}
                selectedOption={sortOrder}
                onChange={(option) => setSortOrder(option.data as "asc" | "desc")}
              />
            </PanelSectionRow>
            <PanelSectionRow>
              <DropdownItem
                label="Tipo"
                rgOptions={[
                  { label: "Todos", data: "all" },
                  { label: "Pastas", data: "folders" },
                  { label: "Arquivos", data: "files" },
                ]}
                selectedOption={fileTypeFilter}
                onChange={(option) => setFileTypeFilter(option.data as string)}
              />
            </PanelSectionRow>
          </div>
        </Focusable>

        <div style={{ flex: 1, minHeight: 0, overflowY: "auto" }}>
          <PanelSection title="ARQUIVOS">
            {fileRows}
          </PanelSection>
        </div>
      </div>
    </Focusable>
  );
}

function Content() {
  const openFullScreen = useCallback(() => {
    Router.CloseSideMenus();
    // Use Navigate instead of NavigateToLayoutPreview to avoid the layout preview
    // which can add default back/home hints in the overlay.
    Router.Navigate?.("/steam-os-file-manager");
  }, []);

  return (
    <PanelSection title="SteamOS File Manager">
      <PanelSectionRow>
        <ButtonItem onClick={openFullScreen}>Abrir gerenciador de arquivos</ButtonItem>
      </PanelSectionRow>
    </PanelSection>
  );
}

routerHook.addRoute("/steam-os-file-manager", FileManagerPage);

export default definePlugin(() => {
  return {
    name: "steamos-file-manager",
    content: <Content />,
    icon: <div />,
  };
});
