{
  "name": "Decky Manager",
  "version": "2.0.0",
  "description": "Better features for Decky",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "package": "pnpm run build && rm -f Decky-Manager.zip && rm -rf .tmp/Decky-Manager && mkdir -p .tmp/Decky-Manager && cp -r dist locales backend package.json plugin.json main.py LICENSE .tmp/Decky-Manager && cd .tmp && zip -r ../Decky-Manager.zip Decky-Manager && cd .. && rm -rf .tmp && echo 'Decky-Manager.zip criado com sucesso.'",
    "watch": "rollup -c -w",
    "auto-package": "pnpm run build && chokidar \"src/**\" -c 'pnpm run package'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "file-manager",
    "overlay"
  ],
  "author": "Ciphay",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Ciphay/Decky-File-Manager/issues"
  },
  "homepage": "https://github.com/Ciphay/Decky-File-Manager",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "chokidar-cli": "^3.0.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
