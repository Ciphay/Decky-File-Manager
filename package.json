{
  "name": "Decky File Manager",
  "version": "2.2.0",
  "description": "Better features for Decky",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "package": "pnpm run build && rm -f Decky-File-Manager.zip && rm -rf .tmp/Decky-File-Manager && mkdir -p .tmp/Decky-File-Manager && cp -r dist locales backend package.json plugin.json main.py LICENSE .tmp/Decky-File-Manager && cd .tmp && zip -r ../Decky-File-Manager.zip Decky-File-Manager && cd .. && rm -rf .tmp && echo 'Decky-File-Manager.zip criado com sucesso.'",
    "watch": "rollup -c -w",
    "auto-package": "pnpm run build && chokidar \"src/**\" -c 'pnpm run package'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**\"",
    "test:backend": "python3 -m unittest discover -s tests/backend -t . -v",
    "test:all": "npm run test:backend && npm run test"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "file-manager",
    "overlay"
  ],
  "author": "Ciphay",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Ciphay/Decky-File-Manager/issues"
  },
  "homepage": "https://github.com/Ciphay/Decky-File-Manager",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^3.2.7",
    "chokidar-cli": "^3.0.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "^4.53.3"
  }
}
